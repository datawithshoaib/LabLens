# Local development values only. Replace these through a secret manager for deployment.
APP_ENV=development
API_V1_PREFIX=/api/v1
API_PORT=8000
FRONTEND_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","api"]

POSTGRES_USER=lablens
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=lablens
DATABASE_URL=postgresql+asyncpg://lablens:local-only-change-me@postgres:5432/lablens
REDIS_PASSWORD=local-only-change-me
REDIS_URL=redis://:local-only-change-me@redis:6379/0
AUTH_REDIS_URL=redis://:local-only-change-me@redis:6379/0

DEVELOPMENT_AUTH_TOKEN=local-only-change-me
OIDC_ISSUER=
OIDC_AUDIENCE=lablens-api
OIDC_JWKS_URL=
OIDC_ALGORITHMS=["RS256"]

AUTH_URL=http://localhost:3000
AUTH_SECRET=development-only-change-this-to-a-random-secret
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_TOKEN_ENDPOINT=
AUTH_OIDC_AUDIENCE=lablens-api
AUTH_OIDC_SCOPE=openid profile email offline_access

STORAGE_BACKEND=filesystem
STORAGE_DIR=/data/uploads
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_SERVER_SIDE_ENCRYPTION=AES256
STORAGE_KMS_KEY_ID=

MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
UPLOAD_LIMIT_PER_HOUR=10
